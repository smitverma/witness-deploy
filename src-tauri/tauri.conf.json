{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Witness",
  "version": "0.1.0-alpha",
  "identifier": "com.smit.witness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Witness — Web Security Testing",
        "width": 720,
        "height": 560,
        "minWidth": 620,
        "minHeight": 480,
        "backgroundColor": "#090b12",
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421 https://github.com https://*.githubusercontent.com https://*.github.com; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/smitverma/witness-deploy/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxMTY1RTI4RjU4QjExMTgKUldRWUVZdjFLRjRXVVo0SW9XSHZDcjVSekpaMmp5aFhBYmNEdVR6VnBiZjhCWlY4ekFGbDhQb2MK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
