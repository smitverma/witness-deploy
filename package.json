{
  "name": "witness",
  "version": "0.1.0-alpha",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "clean": "node -e \"for (const p of ['build','.svelte-kit']) { try { require('fs').rmSync(p, {recursive:true,force:true}); console.log('removed '+p); } catch (e) {} }\"",
    "lint": "echo \"lint: no linter configured\"",
    "test:forge": "node --test tests/forge-lifecycle.test.mjs",
    "test:http-message": "node --test tests/http-message.test.mjs",
    "test:site-map": "node --test tests/site-map.test.mjs",
    "test:intruder": "node --experimental-strip-types --experimental-loader ./tests/tsconfig-paths-loader.mjs --test tests/intruder.test.mjs",
    "test:keyboard-shortcuts": "node --experimental-strip-types --test tests/keyboard-shortcuts.test.mjs",
    "test:toast": "node --experimental-strip-types --test tests/toast.test.mjs",
    "test:format": "node --experimental-strip-types --test tests/format.test.mjs",
    "test:dedup": "node --experimental-strip-types --test tests/dedup.test.mjs",
    "test:http-url": "node --experimental-strip-types --experimental-loader ./tests/tsconfig-paths-loader.mjs --test tests/http-url.test.mjs",
    "test:bridge": "node --test tests/bridge-contract.test.mjs",
    "test": "npm run test:forge && npm run test:http-message && npm run test:site-map && npm run test:intruder && npm run test:keyboard-shortcuts && npm run test:toast && npm run test:format && npm run test:dedup && npm run test:http-url && npm run test:bridge",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:versions": "node -e \"const fs=require('fs');const pkg=JSON.parse(fs.readFileSync('package.json','utf8')).version;const txt=fs.readFileSync('src-tauri/Cargo.toml','utf8');const line=txt.split('\\n').find(function(l){return l.trim().indexOf('version')===0});const cargo=line.split(String.fromCharCode(34))[1];const conf=JSON.parse(fs.readFileSync('src-tauri/tauri.conf.json','utf8')).version;console.log(pkg,cargo,conf);if(pkg!==cargo){process.exit(1)}if(pkg!==conf){process.exit(1)}console.log('sync ok',pkg)\"",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "codemirror": "^6.0.2",
    "driver.js": "^1.8.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
